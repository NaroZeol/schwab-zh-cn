{
  "manifest_version": 3,
  "name": "嘉信理财界面汉化",
  "version": "1.2.16",
  "description": "为嘉信理财客户网站的常用页面提供简体中文界面。",
  "content_scripts": [
    {
      "matches": [
        "https://client.schwab.com/*"
      ],
      "js": [
        "translations.js",
        "translate.js"
      ],
      "css": ["positions.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
